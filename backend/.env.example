PORT=3001

ZABBIX_URL=http://<zabbix-host>:8080/api_jsonrpc.php
ZABBIX_USER=<zabbix-api-user>
ZABBIX_PASSWORD=<zabbix-api-password>

ZAMMAD_URL=https://<zammad-host>/api/v1
# Use either token auth (preferred) or basic auth
ZAMMAD_TOKEN=<zammad-api-token>
# ZAMMAD_EMAIL=<zammad-user-email>
# ZAMMAD_PASSWORD=<zammad-password>

LOKI_URL=http://<loki-host>:3100
LOKI_TIMEOUT=10000
LOKI_CACHE_TTL=300
LOKI_MAX_LIMIT=1000

OXIDIZED_URL=http://<oxidized-host>:8888
